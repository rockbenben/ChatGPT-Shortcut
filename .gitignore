# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Build-time community prompt snapshot (generated by scripts/genCommunitySnapshot.mjs via
# scripts/generate.mjs on prestart/predev/pretypecheck/prebuild/predeploy — never commit).
# 开发钩子只写空 stub（--ensure-only，不发网络请求）；真实数据由 --prod 或 yarn gen:snapshot 抓取。
/src/data/communitySnapshot.json

# antd 静态暗色样式，(antd 版本 × src/theme/antdTokens.mjs) 的纯派生物
# （generated by scripts/genAntdCss.mjs，经 scripts/generate.mjs 在 prestart/predev/pretypecheck/prebuild/predeploy 自动重生成）。
# 曾因 antd 升版后忘记重跑而静默过期：静态 CSS 与运行时 antd 脱节，按钮/hover 停在旧色、构建全绿。
/src/css/antd.dark.css

# Prompt 详情页薄壳，5022 个 (id × locale) 纯派生文件（generated by scripts/genPromptPages.mjs
# from src/data/cards/，经 scripts/generate.mjs 在 prestart/predev/pretypecheck/prebuild/predeploy 重生成 — never commit）。
# 注意：src/data/cards/ 本身**必须**入库——它带着 datePublished/dateModified 状态，
# 是 CodeUpdateHandler.py 增量比对的输入，不是纯派生物。
/src/pages/prompt/
/i18n/*/docusaurus-plugin-content-pages/prompt/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
CHANGELOG.md

.superpowers

/extension
.gstack/
