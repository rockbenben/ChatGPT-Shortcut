# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Build-time community prompt snapshot (generated by scripts/genCommunitySnapshot.mjs;
# regenerated on prestart/prebuild/pretypecheck — never commit)
/src/data/communitySnapshot.json

# Prompt 详情页薄壳，5022 个 (id × locale) 纯派生文件（generated by scripts/genPromptPages.mjs
# from src/data/cards/；regenerated on prestart/prebuild/pretypecheck — never commit）。
# 注意：src/data/cards/ 本身**必须**入库——它带着 datePublished/dateModified 状态，
# 是 CodeUpdateHandler.py 增量比对的输入，不是纯派生物。
/src/pages/prompt/
/i18n/*/docusaurus-plugin-content-pages/prompt/

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
CHANGELOG.md

.superpowers

/extension
.gstack/
